		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Order Year' = LEFT('public orders'[Order Month], 4)
		lineageTag: b2f87b5d-e831-4ec4-a66e-f64457af33cf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'public orders' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "ecommerce_db"),
				    public_orders = Source{[Schema="public",Item="orders"]}[Data]
				in
