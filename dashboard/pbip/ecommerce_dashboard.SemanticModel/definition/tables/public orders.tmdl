table 'public orders'
	lineageTag: ab745770-ab43-4de3-adce-d6db4672985c

	measure 'Total Orders' = CALCULATE(DISTINCTCOUNT('public orders'[order_id]), 'public orders'[order_status] = "delivered")
		formatString: 0
		lineageTag: 9fa96fa7-55b9-4100-a003-239aa318c2e9

	measure 'Total Revenue' = CALCULATE(SUM('public order_payments'[payment_value]), 'public orders'[order_status] = "delivered")
		lineageTag: 1f9281d7-ce2b-4e46-8c3b-00d0882eec81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Payment Row Count' = COUNTROWS('public order_payments')
		formatString: 0
		lineageTag: 0e4984c0-2a11-477a-989b-f5a02447bd37

	measure ': Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		lineageTag: 4e441a42-9fa1-452f-a0b1-8e494f96a456

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Delivery Rate %' = VAR LateCount = CALCULATE( COUNTROWS('public orders'), FILTER( 'public orders', VAR d1 = IFERROR(DATEVALUE('public orders'[order_delivered_customer_date]), BLANK()) VAR d2 = IFERROR(DATEVALUE('public orders'[order_estimated_delivery_date]), BLANK()) RETURN NOT ISBLANK(d1) && NOT ISBLANK(d2) && d1 > d2 ) ) RETURN DIVIDE(LateCount, [Total Orders]) * 100
		formatString: 0.00"%"
		lineageTag: 36eb24c5-7f48-41ea-8a77-2fa2b7c752ef

	measure Measure
		lineageTag: b75e5f43-3853-4941-98fa-142cfd5085c7

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Avg Delay Days' = AVERAGEX(FILTER('public orders', LEN('public orders'[order_delivered_customer_date]) > 5 && LEN('public orders'[order_estimated_delivery_date]) > 5), IFERROR(DATEDIFF(DATEVALUE('public orders'[order_estimated_delivery_date]), DATEVALUE('public orders'[order_delivered_customer_date]), DAY), BLANK()))
		lineageTag: 8a2e6d50-b899-4483-a179-988171c361e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

